 "html": "<div class=\"row\">\r\n    <div class=\"col-xs-6\">\r\n        <h3>Shop Order: {{ doc.name }}</h3>\r\n        <p><strong>Customer:</strong> {{ doc.customer }}</p>\r\n    </div>\r\n    <div class=\"col-xs-6 text-right\">\r\n        <p><strong>Date:</strong> {{ doc.order_date }}</p>\r\n        <p><strong>Status:</strong> {{ doc.order_status }}</p>\r\n    </div>\r\n</div>\r\n\r\n<br>\r\n\r\n<table class=\"table table-bordered table-striped\">\r\n    <thead>\r\n        <tr>\r\n            <th style=\"width: 10%;\">S.NO</th>\r\n            <th style=\"width: 50%;\">Product Category</th>\r\n            <th style=\"width: 20%;\" class=\"text-right\">Quantity</th>\r\n            <th style=\"width: 20%;\" class=\"text-right\">Unit Price</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        <!-- Jinja logic to loop over the child table rows -->\r\n        {% for item in doc.items %}\r\n            <tr>\r\n                <td>{{ loop.index }}</td>\r\n                <td>{{ item.product_category }}</td>\r\n                <td class=\"text-right\">{{ item.quantity }}</td>\r\n                \r\n                <!-- Using Jinja to print the field values -->\r\n                <td class=\"text-right\">{{ item.unit_price }}</td>\r\n            </tr>\r\n        {% endfor %}\r\n    </tbody>\r\n</table>",
